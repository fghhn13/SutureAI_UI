# Copy values into your shell / process manager; the server reads SUTURE_* env vars.
# Data directory for app.db and uploaded videos (default: <repo>/data)
# SUTURE_DATA_DIR=../data
# SUTURE_MAX_UPLOAD_MB=1024
# SUTURE_SESSION_TTL_HOURS=168
# SUTURE_COOKIE_SECURE=0            # set 1 behind HTTPS
# Pipeline providers (only mock/template exist for now)
# SUTURE_SCORING_PROVIDER=mock
# SUTURE_REPORT_PROVIDER=template
# Simulated processing time so the progress UI is visible
# SUTURE_MOCK_SCORING_DELAY_S=4
# SUTURE_MOCK_REPORT_DELAY_S=2
# SUTURE_WORKER_ENABLED=1
